{
  "entities": {
    "ContactInquiry": {
      "title": "Contact Inquiry",
      "description": "Client quote requests, project briefs, and messages sent via contact form or estimator",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "company": { "type": "string", "maxLength": 100 },
        "serviceNeeded": { "type": "string", "maxLength": 50 },
        "projectDescription": { "type": "string", "maxLength": 3000 },
        "budgetRange": { "type": "string", "maxLength": 50 },
        "timeline": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["new", "in_review", "quoted", "archived"] },
        "createdAt": { "type": "string" }
      },
      "required": ["fullName", "email", "serviceNeeded", "projectDescription"]
    },
    "ProjectEstimate": {
      "title": "Project Estimate",
      "description": "Saved project configurations calculated via the interactive simulator",
      "type": "object",
      "properties": {
        "projectType": { "type": "string", "maxLength": 50 },
        "features": { "type": "array" },
        "platforms": { "type": "array" },
        "sla": { "type": "string", "maxLength": 50 },
        "estimatedBudget": { "type": "string", "maxLength": 50 },
        "estimatedTimeline": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["projectType", "estimatedBudget", "estimatedTimeline"]
    },
    "Booking": {
      "title": "Consultation Booking",
      "description": "30-min discovery technical call reservations with engineers",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "topic": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 20 },
        "timeSlot": { "type": "string", "maxLength": 20 },
        "userId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "createdAt": { "type": "string" }
      },
      "required": ["fullName", "email", "topic", "date", "timeSlot"]
    },
    "NewsletterSubscriber": {
      "title": "Newsletter Subscriber",
      "description": "Email subscriptions for technological whitepapers and digital tech insights",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "whitepaperRequested": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "SiteContent": {
      "title": "Site Dynamic Content",
      "description": "Dynamic CMS data for services, portfolio, blog posts, company parameters, and testimonials managed by the admin",
      "type": "object",
      "properties": {
        "contentKey": { "type": "string", "maxLength": 100 },
        "data": { "type": "object" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 150 }
      },
      "required": ["contentKey", "data"]
    },
    "WishlistItem": {
      "title": "Script Wishlist Item",
      "description": "Saved favorite marketplace script for authenticated members",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "scriptId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "priceUSD": { "type": "number" },
        "priceRWF": { "type": "number" },
        "previewImage": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["userId", "scriptId", "title"]
    },
    "ProjectDocument": {
      "title": "Project Document",
      "description": "Secure client deliverables, contracts, technical specifications, and sprint validation reports stored and synced for project milestones",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "milestoneId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "docRef": { "type": "string", "maxLength": 100 },
        "documentType": { "type": "string", "enum": ["contract", "spec", "audit", "delivery_report", "sla", "invoice", "nda"] },
        "fileName": { "type": "string", "maxLength": 250 },
        "fileSize": { "type": "string", "maxLength": 50 },
        "fileUrl": { "type": "string", "maxLength": 1000 },
        "hashSha256": { "type": "string", "maxLength": 64 },
        "version": { "type": "string", "maxLength": 50 },
        "encrypted": { "type": "boolean" },
        "signatories": { "type": "array" },
        "status": { "type": "string", "enum": ["draft", "signed", "certified", "archived"] },
        "uploadedAt": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["projectId", "title", "documentType", "fileName"]
    },
    "DocumentAuditLog": {
      "title": "Document Audit Log",
      "description": "Cryptographic audit trail of all client actions on documents including downloads, digital signatures, integrity verifications, and milestone approvals",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "documentId": { "type": "string", "maxLength": 128 },
        "documentTitle": { "type": "string", "maxLength": 250 },
        "docRef": { "type": "string", "maxLength": 100 },
        "actionType": { "type": "string", "enum": ["signature_created", "document_downloaded", "document_viewed", "document_uploaded", "hash_verified", "milestone_validated"] },
        "actorName": { "type": "string", "maxLength": 150 },
        "actorRole": { "type": "string", "maxLength": 150 },
        "actorEmail": { "type": "string", "maxLength": 150 },
        "actorCompany": { "type": "string", "maxLength": 150 },
        "timestamp": { "type": "string", "maxLength": 100 },
        "timestampUtc": { "type": "string", "maxLength": 100 },
        "ipAddress": { "type": "string", "maxLength": 100 },
        "userAgent": { "type": "string", "maxLength": 300 },
        "certificateId": { "type": "string", "maxLength": 100 },
        "hashSha256": { "type": "string", "maxLength": 64 },
        "verificationStatus": { "type": "string", "enum": ["verified", "tamper_proof", "certified", "standard"] },
        "details": { "type": "string", "maxLength": 1000 },
        "metadata": { "type": "object" }
      },
      "required": ["projectId", "documentTitle", "actionType", "actorName", "actorRole", "timestamp", "timestampUtc"]
    },
    "ClientNotification": {
      "title": "Client Notification",
      "description": "Real-time project notification and alerts for the client portal",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string", "maxLength": 100 },
        "timestampUtc": { "type": "string", "maxLength": 100 },
        "read": { "type": "boolean" },
        "docId": { "type": "string", "maxLength": 128 },
        "docRef": { "type": "string", "maxLength": 100 },
        "milestoneId": { "type": "string", "maxLength": 128 },
        "actionUrl": { "type": "string", "maxLength": 200 },
        "actionLabel": { "type": "string", "maxLength": 100 },
        "actorName": { "type": "string", "maxLength": 150 }
      },
      "required": ["title", "message", "type"]
    },
    "Invoice": {
      "title": "Invoice and Estimate Record",
      "description": "Financial invoices, quotes, deposits, and payment tracking compliant with OHADA standards",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["invoice", "estimate", "deposit"] },
        "clientCompany": { "type": "string", "maxLength": 150 },
        "clientName": { "type": "string", "maxLength": 150 },
        "clientEmail": { "type": "string", "format": "email", "maxLength": 150 },
        "clientAddress": { "type": "string", "maxLength": 300 },
        "clientTaxId": { "type": "string", "maxLength": 100 },
        "currency": { "type": "string", "maxLength": 20 },
        "currencySymbol": { "type": "string", "maxLength": 10 },
        "issueDate": { "type": "string", "maxLength": 50 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["draft", "pending", "paid", "overdue", "cancelled"] },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "taxRate": { "type": "number" },
        "taxAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "paidAt": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["invoiceNumber", "type", "clientCompany", "totalAmount", "status"]
    },
    "InvoiceEmailLog": {
      "title": "Invoice Email Notification Log",
      "description": "Traceability log of automated and manual emails dispatched to clients upon invoice status changes",
      "type": "object",
      "properties": {
        "invoiceId": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 100 },
        "recipientEmail": { "type": "string", "format": "email", "maxLength": 150 },
        "recipientName": { "type": "string", "maxLength": 150 },
        "recipientCompany": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 300 },
        "htmlBody": { "type": "string" },
        "plainTextBody": { "type": "string" },
        "amountFormatted": { "type": "string", "maxLength": 100 },
        "currency": { "type": "string", "maxLength": 20 },
        "sentAt": { "type": "string", "maxLength": 100 },
        "deliveryStatus": { "type": "string", "maxLength": 50 },
        "dispatchedBy": { "type": "string", "maxLength": 150 },
        "trackingCode": { "type": "string", "maxLength": 100 },
        "customNote": { "type": "string", "maxLength": 1000 }
      },
      "required": ["invoiceNumber", "recipientEmail", "status", "subject", "sentAt"]
    }
  },
  "firestore": {
    "/contact_inquiries/{inquiryId}": {
      "schema": "ContactInquiry",
      "description": "Collection of client messages, project requests, and quote submissions"
    },
    "/estimates/{estimateId}": {
      "schema": "ProjectEstimate",
      "description": "Collection of generated project estimates from the interactive calculator"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Scheduled technical appointments and video consultations"
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": "NewsletterSubscriber",
      "description": "Subscribers receiving digital transformation whitepapers and newsletters"
    },
    "/site_content/{contentId}": {
      "schema": "SiteContent",
      "description": "Dynamic content blocks managed in real-time by the site administrator"
    },
    "/wishlists/{wishlistId}": {
      "schema": "WishlistItem",
      "description": "Saved script favorites synchronized in real time for members"
    },
    "/project_documents/{documentId}": {
      "schema": "ProjectDocument",
      "description": "Secure milestone PDF documents, legal contracts, C4 diagrams, and technical specifications"
    },
    "/audit_logs/{logId}": {
      "schema": "DocumentAuditLog",
      "description": "Certified immutable audit trail tracking document downloads, digital signatures, hash checks, and deliveries"
    },
    "/client_notifications/{notificationId}": {
      "schema": "ClientNotification",
      "description": "Real-time client alerts, document release notices, and audit completion events"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Commercial invoices, proforma estimates, and payment reconciliations"
    },
    "/invoice_email_logs/{logId}": {
      "schema": "InvoiceEmailLog",
      "description": "Cryptographic delivery receipts and logs for invoice emails sent to clients"
    }
  }
}
