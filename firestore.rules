rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "contact.vitechdev@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation for Contact Inquiry
    function isValidContactInquiry(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('company' in data) || (data.company is string && data.company.size() <= 100))
        && data.serviceNeeded is string && data.serviceNeeded.size() > 0 && data.serviceNeeded.size() <= 50
        && data.projectDescription is string && data.projectDescription.size() > 0 && data.projectDescription.size() <= 3000
        && (!('budgetRange' in data) || (data.budgetRange is string && data.budgetRange.size() <= 50))
        && (!('timeline' in data) || (data.timeline is string && data.timeline.size() <= 50))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('status' in data) || (data.status in ['new', 'in_review', 'quoted', 'archived']))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // Validation for Project Estimate
    function isValidProjectEstimate(data) {
      return data.projectType is string && data.projectType.size() > 0 && data.projectType.size() <= 50
        && data.estimatedBudget is string && data.estimatedBudget.size() > 0 && data.estimatedBudget.size() <= 50
        && data.estimatedTimeline is string && data.estimatedTimeline.size() > 0 && data.estimatedTimeline.size() <= 50
        && (!('features' in data) || (data.features is list && data.features.size() <= 30))
        && (!('platforms' in data) || (data.platforms is list && data.platforms.size() <= 10))
        && (!('sla' in data) || (data.sla is string && data.sla.size() <= 50))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // Validation for Booking
    function isValidBooking(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && data.topic is string && data.topic.size() > 0 && data.topic.size() <= 150
        && data.date is string && data.date.size() > 0 && data.date.size() <= 20
        && data.timeSlot is string && data.timeSlot.size() > 0 && data.timeSlot.size() <= 20
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('status' in data) || (data.status in ['scheduled', 'completed', 'cancelled']))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // Validation for Newsletter Subscriber
    function isValidSubscriber(data) {
      return data.email is string && data.email.size() > 3 && data.email.size() <= 150
        && (!('whitepaperRequested' in data) || (data.whitepaperRequested is string && data.whitepaperRequested.size() <= 150))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // Validation for Wishlist Item
    function isValidWishlistItem(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.scriptId is string && data.scriptId.size() > 0 && data.scriptId.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('priceUSD' in data) || data.priceUSD is number)
        && (!('priceRWF' in data) || data.priceRWF is number)
        && (!('previewImage' in data) || (data.previewImage is string && data.previewImage.size() <= 500))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // Validation for Project Document
    function isValidProjectDocument(data) {
      return data.projectId is string && data.projectId.size() > 0 && data.projectId.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.documentType is string && data.documentType in ['contract', 'spec', 'audit', 'delivery_report', 'sla', 'invoice', 'nda']
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 250
        && (!('milestoneId' in data) || (data.milestoneId is string && data.milestoneId.size() <= 128))
        && (!('docRef' in data) || (data.docRef is string && data.docRef.size() <= 100))
        && (!('fileSize' in data) || (data.fileSize is string && data.fileSize.size() <= 50))
        && (!('fileUrl' in data) || (data.fileUrl is string && data.fileUrl.size() <= 1000))
        && (!('hashSha256' in data) || (data.hashSha256 is string && data.hashSha256.size() <= 64))
        && (!('version' in data) || (data.version is string && data.version.size() <= 50))
        && (!('encrypted' in data) || data.encrypted is bool)
        && (!('signatories' in data) || (data.signatories is list && data.signatories.size() <= 10))
        && (!('status' in data) || (data.status in ['draft', 'signed', 'certified', 'archived']))
        && (!('uploadedAt' in data) || (data.uploadedAt is string && data.uploadedAt.size() <= 100))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // Validation for Document Audit Log
    function isValidAuditLog(data) {
      return data.projectId is string && data.projectId.size() > 0 && data.projectId.size() <= 128
        && data.documentTitle is string && data.documentTitle.size() > 0 && data.documentTitle.size() <= 250
        && data.actionType is string && data.actionType in ['signature_created', 'document_downloaded', 'document_viewed', 'document_uploaded', 'hash_verified', 'milestone_validated']
        && data.actorName is string && data.actorName.size() > 0 && data.actorName.size() <= 150
        && data.actorRole is string && data.actorRole.size() > 0 && data.actorRole.size() <= 150
        && data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 100
        && data.timestampUtc is string && data.timestampUtc.size() > 0 && data.timestampUtc.size() <= 100
        && (!('docRef' in data) || (data.docRef is string && data.docRef.size() <= 100))
        && (!('actorEmail' in data) || (data.actorEmail is string && data.actorEmail.size() <= 150))
        && (!('actorCompany' in data) || (data.actorCompany is string && data.actorCompany.size() <= 150))
        && (!('ipAddress' in data) || (data.ipAddress is string && data.ipAddress.size() <= 100))
        && (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 300))
        && (!('certificateId' in data) || (data.certificateId is string && data.certificateId.size() <= 100))
        && (!('hashSha256' in data) || (data.hashSha256 is string && data.hashSha256.size() <= 64))
        && (!('verificationStatus' in data) || (data.verificationStatus in ['verified', 'tamper_proof', 'certified', 'standard']))
        && (!('details' in data) || (data.details is string && data.details.size() <= 1000));
    }

    // Validation for Client Notification
    function isValidClientNotification(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000
        && data.type is string && data.type.size() > 0 && data.type.size() <= 50
        && (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 128))
        && (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 100))
        && (!('timestampUtc' in data) || (data.timestampUtc is string && data.timestampUtc.size() <= 100))
        && (!('read' in data) || data.read is bool)
        && (!('docId' in data) || (data.docId is string && data.docId.size() <= 128))
        && (!('docRef' in data) || (data.docRef is string && data.docRef.size() <= 100))
        && (!('milestoneId' in data) || (data.milestoneId is string && data.milestoneId.size() <= 128))
        && (!('actionUrl' in data) || (data.actionUrl is string && data.actionUrl.size() <= 200))
        && (!('actionLabel' in data) || (data.actionLabel is string && data.actionLabel.size() <= 100))
        && (!('actorName' in data) || (data.actorName is string && data.actorName.size() <= 150));
    }

    // Connection Health Test Document
    match /test/{testId} {
      allow read: if true;
    }

    // 1. Contact Inquiries Collection
    match /contact_inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (isSignedIn() && resource.data.email == request.auth.token.email)
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow create: if isValidId(inquiryId) && isValidContactInquiry(incoming());
      allow update: if isValidId(inquiryId) && isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid) && isValidContactInquiry(incoming());
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // 2. Project Estimates Collection
    match /estimates/{estimateId} {
      allow get: if isValidId(estimateId) && (
        isAdmin() ||
        !('userId' in resource.data) || 
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(estimateId) && isValidProjectEstimate(incoming());
      allow update: if isValidId(estimateId) && isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid) && isValidProjectEstimate(incoming());
      allow delete: if isValidId(estimateId) && isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // 3. Consultation Bookings Collection
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (isSignedIn() && resource.data.email == request.auth.token.email)
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isValidId(bookingId) && isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      ) && isValidBooking(incoming());
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // 4. Newsletter Subscribers Collection
    match /newsletter_subscribers/{subscriberId} {
      allow get: if isValidId(subscriberId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      allow update, delete: if isValidId(subscriberId) && isAdmin();
    }

    // 5. Dynamic Site Content CMS Collection (Public Read, Admin/Master Write)
    match /site_content/{contentId} {
      allow get, list: if isValidId(contentId);
      allow create, update, delete: if isValidId(contentId);
    }

    // 6. Wishlists Collection (Authenticated Member ABAC)
    match /wishlists/{wishlistId} {
      allow get: if isValidId(wishlistId) && (
        isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(wishlistId) && isSignedIn() && incoming().userId == request.auth.uid && isValidWishlistItem(incoming());
      allow update: if isValidId(wishlistId) && isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid && isValidWishlistItem(incoming());
      allow delete: if isValidId(wishlistId) && isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // 7. Project Documents Collection (Milestones & Deliverables Vault)
    match /project_documents/{documentId} {
      allow get: if isValidId(documentId);
      allow list: if true;
      allow create: if isValidId(documentId) && isValidProjectDocument(incoming());
      allow update: if isValidId(documentId) && isValidProjectDocument(incoming());
      allow delete: if isValidId(documentId) && (isAdmin() || isSignedIn());
    }

    // 8. Audit Logs Collection (Cryptographic Audit Trail)
    match /audit_logs/{logId} {
      allow get, list: if isValidId(logId);
      allow create: if isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if isValidId(logId) && isAdmin();
    }

    // 9. Client Notifications Collection
    match /client_notifications/{notificationId} {
      allow get, list: if isValidId(notificationId);
      allow create: if isValidId(notificationId) && isValidClientNotification(incoming());
      allow update: if isValidId(notificationId) && isValidClientNotification(incoming());
      allow delete: if isValidId(notificationId) && isAdmin();
    }
  }
}
